---
import ArticleView from '../../blog/ArticleView.astro';
import { postsIn, type Post } from '../../blog/data';

export async function getStaticPaths() {
  return (await postsIn('fr')).map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
---

<ArticleView post={post} />
